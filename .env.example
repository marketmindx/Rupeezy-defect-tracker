# ---------------------------------------------------------------------------
# Rupeezy Defect Tracker — environment configuration.
# Copy to `.env` and adjust. Every value has a safe local default except
# SECRET_KEY, which is REQUIRED when APP_ENV=production.
# ---------------------------------------------------------------------------

# development | testing | production
APP_ENV=development

# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# SQLite is the default (file lives at ./instance/defect_tracker.db).
# To move to PostgreSQL later, set this and run migrations — no code changes:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/defect_tracker

# APP_NAME=Rupeezy Defect Tracker
# LOG_LEVEL=INFO
# LOG_DIR=./logs
# UPLOAD_FOLDER=./uploads
# MAX_UPLOAD_MB=200

# Dev server binding (used by run.py). Port 5001 avoids the macOS AirPlay
# Receiver, which squats on port 5000.
# HOST=127.0.0.1
# PORT=5001

# Log raw SQL in development (1/true to enable)
# SQL_ECHO=0
